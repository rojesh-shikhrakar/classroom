{
	"name": "classroom",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "CI=1 wrangler d1 migrations apply personal-class --local && vite dev",
		"build": "vite build",
		"deploy": "bun run db:migrate:remote && wrangler deploy",
		"check:worker-types": "vite build && wrangler types --check",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run",
		"test:e2e": "playwright test",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:local": "CI=1 wrangler d1 migrations apply personal-class --local",
		"db:migrate:remote": "CI=1 CLOUDFLARE_API_TOKEN=$CLOUDFLARE_D1_TOKEN wrangler d1 migrations apply personal-class --remote",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@isomorphic-git/lightning-fs": "^4.7.0",
		"@types/diff": "^8.0.0",
		"@types/dompurify": "^3.2.0",
		"@types/markdown-it": "^14.2.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"buffer": "^6.0.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"diff": "^9.0.0",
		"dompurify": "^3.4.15",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"isomorphic-git": "^1.42.2",
		"markdown-it": "^15.0.2",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shiki": "^4.4.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	}
}

{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "classroom",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"secrets": {
		"required": ["ORIGIN", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "personal-class",
			"database_id": "593d87e1-d8de-4bdc-a087-9954351fa254",
			"migrations_dir": "drizzle",
			"remote": true
		}
	]
}
